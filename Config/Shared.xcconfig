// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = MousePlus
PRODUCT_DISPLAY_NAME = MousePlus
PRODUCT_BUNDLE_IDENTIFIER = com.xpycode.MousePlus
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Build Settings
// ==========================================
ALWAYS_SEARCH_USER_PATHS = NO

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// Menu bar app - no dock icon
INFOPLIST_KEY_LSUIElement = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/MousePlus.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/MousePlus.entitlements