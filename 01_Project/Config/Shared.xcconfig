// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = MousePlus
PRODUCT_DISPLAY_NAME = MousePlus
PRODUCT_BUNDLE_IDENTIFIER = com.xpycode.MousePlus
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Build Settings
// ==========================================
ALWAYS_SEARCH_USER_PATHS = NO

// ==========================================
// Info PLIST
// ==========================================
// Static Info.plist — required for arbitrary keys like
// NSAccessibilityUsageDescription that the auto-mapped
// INFOPLIST_KEY_* mechanism does not cover.
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/MousePlus.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/MousePlus.entitlements

// MousePlus is non-sandboxed by design: global event monitors and AX APIs
// require it. Direct distribution (GPLv3) is the planned channel; MAS is
// not in scope. Keep this aligned with MousePlus.entitlements.
ENABLE_APP_SANDBOX = NO